{
  "name": "fps-web-game",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx/esm server/index.ts & vite --host 0.0.0.0",
    "serve:public": "npm run build && node --import tsx/esm server/public.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "dust2:preflight": "node scripts/import-dust2-goldsrc.mjs --check",
    "dust2:import": "node scripts/import-dust2-goldsrc.mjs --out-ts client/src/game/generated/dust2-world-mesh.ts",
    "dust2:verify": "node scripts/verify-dust2-generated.mjs",
    "dust2:routes": "node scripts/verify-dust2-routes.mjs",
    "dust2:status": "node scripts/status-dust2.mjs",
    "dust2:screenshots": "node scripts/screenshot-dust2.mjs",
    "dust2:render": "python3 scripts/render-dust2-software.py",
    "test:e2e:feel": "node tests/e2e/csgo-feel-smoke.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "three": "^0.158.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/three": "^0.184.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.44.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
